---
const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden bg-stone-900 px-6 py-12 text-white">
  <div class="relative z-10 mx-auto max-w-7xl">
    <div class="mb-10 flex flex-col items-center justify-between gap-10 text-center md:flex-row md:items-start md:text-left">
      <div class="flex max-w-xs flex-col items-center md:items-start">
        <a
          href="/"
          class="mb-4 flex items-center gap-2 font-heading text-2xl tracking-tight"
        >
          <img
            src="/static/images/brand/disbug-beetle-mark-white.svg"
            alt=""
            width="32"
            height="32"
            loading="lazy"
            decoding="async"
            class="h-7 w-7 -translate-y-0.5"
          />
          <span>Disbug</span>
        </a>
        <p class="mb-6 text-sm leading-relaxed text-white/70">
          Faster feedback loop for AI coding agents. Capture browser bugs as
          evidence agents can actually fix from.
        </p>
        <div class="flex gap-3">
          <a
            href="https://x.com/aswin_db"
            target="_blank"
            rel="noopener"
            aria-label="Disbug on X"
            class="flex h-8 w-8 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-white/60 transition-all hover:bg-white hover:text-stone-900"
          >
            <i
              class="hgi-stroke hgi-new-twitter text-sm"
              aria-hidden="true"
            ></i>
          </a>
          <a
            href="https://github.com/disbug-io"
            target="_blank"
            rel="noopener"
            aria-label="Disbug on GitHub"
            class="flex h-8 w-8 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-white/60 transition-all hover:bg-white hover:text-stone-900"
          >
            <i class="hgi-stroke hgi-github text-sm" aria-hidden="true"></i>
          </a>
          <a
            href="https://linkedin.com/company/disbug"
            target="_blank"
            rel="noopener"
            aria-label="Disbug on LinkedIn"
            class="flex h-8 w-8 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-white/60 transition-all hover:bg-white hover:text-stone-900"
          >
            <i
              class="hgi-stroke hgi-linkedin-01 text-sm"
              aria-hidden="true"
            ></i>
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 md:gap-14 lg:grid-cols-3">
        <div class="flex flex-col items-center md:items-start">
          <h2 class="ds-label-sm mb-5 text-white/40">Product</h2>
          <ul class="space-y-3 text-sm font-medium">
            <li>
              <a
                href="/#how-it-works"
                class="text-white/80 transition-colors hover:text-white"
              >
                How It Works
              </a>
            </li>
            <li>
              <a
                href="/#features"
                class="text-white/80 transition-colors hover:text-white"
              >
                Features
              </a>
            </li>
            <li>
              <a
                href="/pricing/"
                class="text-white/80 transition-colors hover:text-white"
              >
                Pricing
              </a>
            </li>
            <li>
              <a
                href="/en/blog/"
                class="text-white/80 transition-colors hover:text-white"
              >
                Blog
              </a>
            </li>
          </ul>
        </div>
        <div class="flex flex-col items-center md:items-start">
          <h2 class="ds-label-sm mb-5 text-white/40">Legal</h2>
          <ul class="space-y-3 text-sm font-medium">
            <li>
              <a
                href="/terms-and-conditions/"
                class="text-white/80 transition-colors hover:text-white"
              >
                Terms &amp; Conditions
              </a>
            </li>
            <li>
              <a
                href="/privacy-policy/"
                class="text-white/80 transition-colors hover:text-white"
              >
                Privacy Policy
              </a>
            </li>
            <li>
              <a
                href="/refund-policy/"
                class="text-white/80 transition-colors hover:text-white"
              >
                Refund Policy
              </a>
            </li>
          </ul>
        </div>
        <div class="flex flex-col items-center md:items-start">
          <h2 class="ds-label-sm mb-5 text-white/40">Support</h2>
          <ul class="space-y-3 text-sm font-medium">
            <li>
              <a
                href="mailto:team@disbug.io"
                class="text-white/80 transition-colors hover:text-white"
              >
                Email Support
              </a>
            </li>
            <li>
              <a
                href="/contact-us/"
                class="text-white/80 transition-colors hover:text-white"
              >
                Contact Us
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="flex items-center justify-center border-t border-white/10 pt-8">
      <p class="ds-label-sm text-center text-white/30">
        &copy; {year} Disbug. All rights reserved.
      </p>
    </div>
  </div>
</footer>
