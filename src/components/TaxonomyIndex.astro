---
interface Item {
  slug: string;
  name: string;
  count: number;
}

interface Props {
  title: string;
  items: Item[];
  itemUrlPrefix: string;
}

const { title, items, itemUrlPrefix } = Astro.props;
---

<main class="bg-stone-50">
  <section class="border-b border-stone-200 bg-white">
    <div class="mx-auto max-w-5xl px-6 py-9 md:py-12">
      <h1 class="max-w-3xl font-heading text-3xl leading-tight text-stone-900 md:text-4xl">
        {title}
      </h1>
    </div>
  </section>
  <section class="mx-auto max-w-5xl px-6 py-8 md:py-10">
    <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => (
        <a
          href={`${itemUrlPrefix}${item.slug}/`}
          class="border border-stone-200 bg-white p-5 transition duration-200 hover:border-stone-900/30"
        >
          <span class="font-heading text-2xl text-stone-900">{item.name}</span>
          <span class="mt-2 block font-mono text-xs uppercase text-stone-400">
            {item.count} {item.count === 1 ? 'article' : 'articles'}
          </span>
        </a>
      ))}
    </div>
  </section>
</main>
