                      <script is:inline>
                        function agentFixAnimation() {
                          return {
                            lines: [],
                            currentRunId: 0,

                            sequence: [
                              {
                                type: 'text',
                                text: 'Looking for the latest bug...',
                                color: 'text-white/90',
                                icon: '›',
                                delay: 10,
                                pauseAfter: 500,
                              },

                              {
                                type: 'status',
                                title: 'Session loaded',
                                delay: 0,
                              },
                              {
                                type: 'status',
                                title: 'Analysis complete',
                                delay: 0,
                                pauseAfter: 400,
                              },

                              {
                                type: 'text',
                                text: 'Found 3 errors and 2 failed requests.',
                                color: 'text-white/60',
                                icon: '',
                                delay: 5,
                                pauseAfter: 500,
                              },

                              {
                                type: 'text',
                                text: '<span class="text-white/30">Issue found:</span>',
                                color: 'text-white/30',
                                icon: '',
                                delay: 0,
                              },
                              {
                                type: 'text',
                                text: 'The payment flow stops before completing checkout.',
                                color: 'text-white/90',
                                icon: '',
                                delay: 5,
                                pauseAfter: 800,
                              },

                              {
                                type: 'status',
                                title: 'Fix applied',
                                items: [
                                  'Restored payment handler',
                                  'Added safety fallback',
                                  'Improved validation',
                                ],
                                pauseAfter: 600,
                              },

                              {
                                type: 'status',
                                title: 'Verification passed',
                                delay: 0,
                              },
                              {
                                type: 'status',
                                title: 'Tests passed',
                                delay: 0,
                                pauseAfter: 500,
                              },

                              {
                                type: 'status',
                                title: 'Pull request prepared',
                                delay: 0,
                                pauseAfter: 600,
                              },

                              { type: 'pr', pauseAfter: 4000 },
                            ],

                            init() {
                              const parentCarousel = this.$el.closest(
                                '[x-data*="carousel"]',
                              );
                              if (parentCarousel) {
                                // Inside tab carousel: wait for tab-switched event to start fresh
                                return;
                              }
                              this.reset();
                            },

                            async reset() {
                              const runId = ++this.currentRunId;
                              this.lines = [];

                              await this.sleep(400);
                              if (this.currentRunId !== runId) return;

                              for (let item of this.sequence) {
                                if (this.currentRunId !== runId) return;

                                if (item.type === 'text') {
                                  await this.addTextLine(item, runId);
                                } else {
                                  this.lines.push(item);
                                }

                                if (this.currentRunId !== runId) return;

                                if (item.pauseAfter) {
                                  await this.sleep(item.pauseAfter);
                                } else {
                                  await this.sleep(100);
                                }
                              }

                              if (this.currentRunId === runId) {
                                await this.sleep(3000);
                                if (this.currentRunId === runId) {
                                  this.reset();
                                }
                              }
                            },

                            async addTextLine(data, runId) {
                              const newLine = {
                                ...data,
                                displayed: '',
                                isTyping: true,
                              };
                              this.lines.push(newLine);
                              const index = this.lines.length - 1;

                              let text = data.text;
                              let displayed = '';
                              let i = 0;

                              if (data.delay === 0) {
                                if (this.lines[index]) {
                                  this.lines[index].displayed = text;
                                  this.lines[index].isTyping = false;
                                }
                                return;
                              }

                              while (i < text.length) {
                                if (this.currentRunId !== runId) return;
                                if (text[i] === '<') {
                                  const end = text.indexOf('>', i);
                                  displayed += text.slice(i, end + 1);
                                  i = end + 1;
                                } else {
                                  displayed += text[i];
                                  i++;
                                  if (this.lines[index]) {
                                    this.lines[index].displayed = displayed;
                                  }
                                  await this.sleep(data.delay || 10);
                                }
                              }
                              if (this.lines[index]) {
                                this.lines[index].isTyping = false;
                              }
                            },

                            sleep(ms) {
                              return new Promise((resolve) =>
                                setTimeout(resolve, ms),
                              );
                            },

                            destroy() {
                              this.currentRunId++;
                            },
                          };
                        }
                      </script>
