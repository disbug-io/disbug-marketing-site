  <script is:inline>
    function carousel() {
      return {
        activeTab: 'capture',
        progress: 0,
        completedTabs: [],
        tabs: [
          {
            id: 'capture',
            label: 'Capture',
            caption:
              'Click the pinned Disbug icon on any web app. Disbug grabs screenshot, DOM selectors, console errors, network failures, and the user-event trail in the background.',
            duration: 7000,
          },
          {
            id: 'mcp',
            label: 'MCP Config',
            caption:
              'Add one block to your agent config. The same JSON works for Claude Code, Claude Desktop, Codex, Cursor, OpenClaw, and Hermes.',
            duration: 4000,
          },
          {
            id: 'agent',
            label: 'Agent Fix',
            caption:
              'Your agent pulls the session, fetches only the fields it needs, identifies the bug, writes the fix, and opens the PR.',
            duration: 10000,
          },
        ],
        interval: null,
        lastTick: null,
        isVisible: false,

        init() {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  if (!this.isVisible) {
                    this.isVisible = true;
                    this.restartSequence();
                  }
                } else {
                  this.isVisible = false;
                  this.stopAutoplay();
                }
              });
            },
            { threshold: 0.15 },
          );

          observer.observe(this.$el);
        },

        restartSequence() {
          const ids = this.tabs.map((t) => t.id);
          this.activeTab = ids[0];
          this.progress = 0;
          this.completedTabs = [];
          this.$dispatch('tab-switched', { tab: this.activeTab });
          this.startAutoplay();
        },

        startAutoplay() {
          this.stopAutoplay();
          this.lastTick = Date.now();
          this.interval = setInterval(() => {
            if (!this.isVisible) return;

            const now = Date.now();
            const delta = now - this.lastTick;
            this.lastTick = now;

            const currentTab = this.tabs.find((t) => t.id === this.activeTab);
            const duration = currentTab ? currentTab.duration : 6000;

            this.progress += (delta / duration) * 100;

            if (this.progress >= 100) {
              this.nextTab();
            }
          }, 20);
        },

        stopAutoplay() {
          if (this.interval) {
            clearInterval(this.interval);
            this.interval = null;
          }
        },

        nextTab() {
          const ids = this.tabs.map((t) => t.id);
          const currentIndex = ids.indexOf(this.activeTab);

          if (!this.completedTabs.includes(this.activeTab)) {
            this.completedTabs.push(this.activeTab);
          }

          if (currentIndex === ids.length - 1) {
            this.activeTab = ids[0];
            this.completedTabs = [];
          } else {
            this.activeTab = ids[currentIndex + 1];
          }

          this.progress = 0;
          this.lastTick = Date.now();

          // Dispatch event to reset sub-animations
          this.$dispatch('tab-switched', { tab: this.activeTab });
        },

        selectTab(tabId) {
          const ids = this.tabs.map((t) => t.id);
          const targetIndex = ids.indexOf(tabId);

          this.activeTab = tabId;
          this.progress = 0;
          this.lastTick = Date.now();
          this.completedTabs = ids.slice(0, targetIndex);

          this.$dispatch('tab-switched', { tab: this.activeTab });
        },
      };
    }
  </script>
