  <script is:inline>
    function heroAnimation() {
      return {
        step: 0,
        showToast: false,
        showExtension: true,
        commandLine: '',
        isTypingCommand: false,
        cursor: { x: 400, y: 300, visible: false, clicking: false },
        terminalLines: [],

        sequence: [
          {
            type: 'status',
            title: 'Analysis complete',
            delay: 0,
            pauseAfter: 400,
          },
          {
            type: 'text',
            text: 'Found 3 errors and 2 failed requests.',
            color: 'text-white/60',
            icon: '',
            delay: 5,
            pauseAfter: 500,
            margin: true,
          },
          {
            type: 'text',
            text: '<span class="text-white/30">Issue found:</span>',
            color: 'text-white/30',
            icon: '',
            delay: 0,
            margin: true,
          },
          {
            type: 'text',
            text: 'The payment flow stops before completing checkout.',
            color: 'text-white/90',
            icon: '',
            delay: 5,
            pauseAfter: 800,
          },
          {
            type: 'status',
            title: 'Fix applied',
            items: ['Restored payment handler', 'Added safety fallback'],
            pauseAfter: 600,
            margin: true,
          },
          { type: 'status', title: 'Verification passed', delay: 0 },
          { type: 'status', title: 'Tests passed', delay: 0, pauseAfter: 500 },
          {
            type: 'status',
            title: 'Pull request prepared',
            delay: 0,
            pauseAfter: 400,
            margin: true,
          },
          {
            type: 'text',
            text: '<span class="text-white/40">Branch:</span> <span class="text-blue-400 underline cursor-pointer">https://github.com/acme/app/tree/fix/checkout-handler</span>',
            color: '',
            delay: 0,
            pauseAfter: 800,
          },
          {
            type: 'text',
            text: 'Raise pull request? (Y/n)',
            color: 'text-white/30',
            delay: 5,
            pauseAfter: 300,
          },
          { type: 'pr', text: 'Y', pauseAfter: 1000 },
        ],

        async init() {
          while (true) {
            await this.reset();
            await this.sleep(400);

            this.step = 1;
            this.cursor.visible = true;
            await this.moveCursorTo('#field-card', 'center', 'center');
            await this.sleep(150);

            this.step = 2;
            await this.click();
            await this.sleep(250);

            this.step = 3;
            await this.moveCursorTo('#btn-pay button', 'center', 'center');
            await this.sleep(150);

            this.step = 4;
            await this.click();
            await this.sleep(300);

            // Transition to extension
            this.step = 5;
            await this.moveCursorTo('#ext-download', 'center', 'center');
            await this.sleep(150);

            this.step = 6;
            await this.click();
            this.showExtension = false;
            this.showToast = true;
            await this.sleep(1500);
            this.showToast = false;
            await this.sleep(500);

            this.step = 13; // Transition focus to agent
            this.cursor.visible = false;
            await this.sleep(600);

            this.step = 14; // Type command
            this.isTypingCommand = true;
            await this.typeText(
              'this',
              'commandLine',
              'disbug inspect ~/Downloads/disbug-report-7392.json',
            );
            this.isTypingCommand = false;
            await this.sleep(800);

            this.step = 15; // Milestone: Session gathered
            await this.sleep(800);

            this.step = 16; // Analysis begins
            for (let item of this.sequence) {
              if (item.title === 'Fix applied') this.step = 17;
              if (item.type === 'text') {
                await this.addTerminalTextLine(item);
              } else {
                this.terminalLines.push(item);
              }

              if (item.pauseAfter) {
                await this.sleep(item.pauseAfter);
              } else {
                await this.sleep(100);
              }
            }

            this.step = 18; // Done
            await this.sleep(1000);
          }
        },

        async reset() {
          this.step = 0;
          this.showToast = false;
          this.showExtension = true;
          this.commandLine = '';
          this.isTypingCommand = false;
          this.cursor = { x: 400, y: 300, visible: false, clicking: false };
          this.terminalLines = [];
        },

        async moveCursorTo(selector, alignX = 'center', alignY = 'center') {
          // Wait for Alpine to render any visibility/style changes before measuring
          await this.sleep(50);

          const scope = this.$el;
          const el = scope.querySelector(selector);

          if (el) {
            const rect = el.getBoundingClientRect();
            const containerRect = this.$refs.container.getBoundingClientRect();

            // Precise Targeting Calculation
            // SVG tip is at ~ (4,2). The container tip transform already moves it back by (-4, -2).
            // So we just need the raw coordinates relative to the parent container.
            let targetX = rect.left - containerRect.left;
            let targetY = rect.top - containerRect.top;

            if (alignX === 'center') targetX += rect.width / 2;
            else if (alignX === 'right') targetX += rect.width;

            if (alignY === 'center') targetY += rect.height / 2;
            else if (alignY === 'bottom') targetY += rect.height;

            this.cursor.x = targetX;
            this.cursor.y = targetY;
            await this.sleep(500);
          }
        },

        async click() {
          await this.sleep(100);
          this.cursor.clicking = true;
          await this.sleep(80);
          this.cursor.clicking = false;
          await this.sleep(80);
        },

        async typeText(obj, key, text) {
          const words = text.split(' ');
          let currentText = '';
          const target = obj === 'this' ? this : this[obj];

          for (let i = 0; i < words.length; i++) {
            const word = words[i] + (i < words.length - 1 ? ' ' : '');
            for (let char of word) {
              currentText += char;
              target[key] = currentText;
              await this.sleep(10 + Math.random() * 20);
            }
            if (Math.random() > 0.8) await this.sleep(30 + Math.random() * 50);
          }
        },

        async addTerminalTextLine(data) {
          const newLine = { ...data, displayed: '', isTyping: true };
          this.terminalLines.push(newLine);
          const index = this.terminalLines.length - 1;

          let text = data.text;
          let displayed = '';
          let i = 0;

          if (data.delay === 0) {
            this.terminalLines[index].displayed = text;
            this.terminalLines[index].isTyping = false;
            return;
          }

          while (i < text.length) {
            if (text[i] === '<') {
              const end = text.indexOf('>', i);
              displayed += text.slice(i, end + 1);
              i = end + 1;
            } else {
              displayed += text[i];
              i++;
              this.terminalLines[index].displayed = displayed;
              await this.sleep(data.delay || 10);
            }
          }
          this.terminalLines[index].isTyping = false;
        },

        sleep(ms) {
          return new Promise((resolve) => setTimeout(resolve, ms));
        },
      };
    }
  </script>
</section>

