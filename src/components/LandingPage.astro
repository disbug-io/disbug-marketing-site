                      <script is:inline>
                        function captureAnimation() {
                          return {
                            step: 0,
                            cursor: {
                              x: 300,
                              y: 200,
                              visible: false,
                              clicking: false,
                            },
                            sidebar: {
                              title: '',
                              showPins: false,
                              showStats: false,
                              isTypingTitle: false,
                            },
                            isDestroyed: false,

                            init() {
                              this.reset();
                            },

                            async reset() {
                              this.isDestroyed = false;
                              this.step = 0;
                              this.cursor = {
                                x: 300,
                                y: 200,
                                visible: false,
                                clicking: false,
                              };
                              this.sidebar = {
                                title: '',
                                showPins: false,
                                showStats: false,
                                isTypingTitle: false,
                              };

                              await this.sleep(500);
                              if (this.isDestroyed) return;

                              // 1. Move to Card Field
                              this.step = 1;
                              this.cursor.visible = true;
                              await this.moveCursorTo(
                                '#capture-field-card',
                                'center',
                                'center',
                              );
                              if (this.isDestroyed) return;

                              // 2. Click Card Field
                              this.step = 2;
                              await this.click();
                              await this.sleep(300);
                              if (this.isDestroyed) return;

                              // 3. Move to Pay Button
                              this.step = 3;
                              await this.moveCursorTo(
                                '#capture-btn-pay button',
                                'center',
                                'center',
                              );
                              if (this.isDestroyed) return;

                              // 4. Click Pay Button
                              this.step = 4;
                              await this.click();
                              await this.sleep(400);
                              if (this.isDestroyed) return;

                              // 5. Type Sidebar Title
                              this.step = 5;
                              this.sidebar.isTypingTitle = true;
                              await this.typeText(
                                'sidebar',
                                'title',
                                'Pay button not responding on checkout',
                              );
                              this.sidebar.isTypingTitle = false;
                              await this.sleep(300);
                              if (this.isDestroyed) return;

                              // 6. Show Pins
                              this.step = 6;
                              this.sidebar.showPins = true;
                              await this.sleep(400);
                              if (this.isDestroyed) return;

                              // 7. Show Stats
                              this.step = 7;
                              this.sidebar.showStats = true;
                              await this.sleep(400);
                              if (this.isDestroyed) return;

                              // 8. Move to Send to Agent
                              this.step = 8;
                              await this.moveCursorTo(
                                '#capture-btn-send',
                                'center',
                                'center',
                              );
                              if (this.isDestroyed) return;

                              // 9. Click Send to Agent
                              this.step = 9;
                              await this.click();
                              await this.sleep(500);
                              if (this.isDestroyed) return;

                              // 10. Done
                              this.step = 10;
                              this.cursor.visible = false;
                            },

                            async moveCursorTo(
                              selector,
                              alignX = 'center',
                              alignY = 'center',
                            ) {
                              const el = document.querySelector(selector);
                              if (el) {
                                const rect = el.getBoundingClientRect();
                                const containerRect = el
                                  .closest('[x-data]')
                                  .getBoundingClientRect();

                                let targetX = rect.left - containerRect.left;
                                let targetY = rect.top - containerRect.top;

                                if (alignX === 'center')
                                  targetX += rect.width / 2;
                                else if (alignX === 'right')
                                  targetX += rect.width;
                                else if (typeof alignX === 'number')
                                  targetX += alignX;

                                if (alignY === 'center')
                                  targetY += rect.height / 2;
                                else if (alignY === 'bottom')
                                  targetY += rect.height;
                                else if (typeof alignY === 'number')
                                  targetY += alignY;

                                this.cursor.x = targetX;
                                this.cursor.y = targetY;
                                await this.sleep(600);
                              }
                            },

                            async click() {
                              await this.sleep(100);
                              this.cursor.clicking = true;
                              await this.sleep(100);
                              this.cursor.clicking = false;
                              await this.sleep(100);
                            },

                            async typeText(obj, key, text) {
                              let currentText = '';
                              for (let char of text) {
                                if (this.isDestroyed) return;
                                currentText += char;
                                this[obj][key] = currentText;
                                await this.sleep(20 + Math.random() * 30);
                              }
                            },

                            sleep(ms) {
                              return new Promise((resolve) =>
                                setTimeout(resolve, ms),
                              );
                            },

                            destroy() {
                              this.isDestroyed = true;
                            },
                          };
                        }
                      </script>
