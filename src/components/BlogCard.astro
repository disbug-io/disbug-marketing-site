---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
---

<article class="group flex h-full flex-col border border-stone-200 bg-white p-4 transition duration-200 hover:border-stone-900/30">
  <a href={post.data.url} class="block overflow-hidden bg-stone-100">
    {post.data.image ? (
      <img
        src={post.data.image}
        alt={post.data.title}
        loading="lazy"
        decoding="async"
        class="aspect-3/2 w-full object-cover transition duration-200 group-hover:scale-[1.02]"
      />
    ) : (
      <span class="flex aspect-3/2 items-center justify-center border border-stone-200 bg-white p-6 text-center font-heading text-3xl leading-none text-stone-900">
        {post.data.title.charAt(0)}
      </span>
    )}
  </a>
  <div class="flex flex-1 flex-col pt-4">
    <div class="mb-3 flex flex-wrap items-center gap-2 text-xs text-stone-400">
      {post.data.published_at && (
        <span class="font-mono uppercase">
          {String(post.data.published_at)}
        </span>
      )}
      {post.data.author && <span>{post.data.author}</span>}
    </div>
    <h2 class="font-heading text-xl leading-tight text-stone-900 md:text-2xl">
      <a href={post.data.url} class="hover:text-stone-900/70">
        {post.data.title}
      </a>
    </h2>
    {post.data.description && (
      <p class="mt-3 line-clamp-3 text-sm leading-6 text-stone-500">
        {post.data.description}
      </p>
    )}
    {post.data.tags.length > 0 && (
      <div class="mt-auto flex flex-wrap gap-2 pt-4">
        {post.data.tags.slice(0, 3).map((tag) => (
          <span class="border border-stone-200 px-2 py-1 font-mono text-[11px] uppercase text-stone-400">
            {tag}
          </span>
        ))}
      </div>
    )}
  </div>
</article>
