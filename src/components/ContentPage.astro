---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  page: CollectionEntry<'marketing'>;
  label?: string;
}

const { page, label = 'Legal Information' } = Astro.props;
const { Content } = await render(page);
---

<main class="overflow-hidden bg-white pb-16 md:pb-18">
  <section class="relative mx-auto max-w-3xl px-6 pb-12 pt-10 text-center">
    <div
      class="mb-8 inline-flex animate-fade-in-up items-center gap-2 rounded-full border border-stone-100 bg-stone-50/50 px-4 py-1.5"
      style="animation-delay: 50ms;"
    >
      <i class="hgi-stroke hgi-file-01 text-[12px] text-stone-400"></i>
      <span class="ds-label-sm text-stone-400">{label}</span>
    </div>

    <h1
      class="mb-6 animate-fade-in-up font-heading text-4xl leading-tight tracking-tight text-stone-900 sm:text-4xl md:text-5xl"
      style="animation-delay: 100ms;"
    >
      {page.data.title}
    </h1>
  </section>

  <section
    class="mx-auto max-w-4xl animate-fade-in-up px-6"
    style="animation-delay: 300ms;"
  >
    <div class="prose prose-sm prose-stone max-w-none text-justify prose-headings:text-left prose-headings:font-heading prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-stone-900 prose-p:leading-relaxed prose-p:text-stone-600 prose-a:text-stone-900 prose-a:underline prose-a:underline-offset-4 prose-strong:font-semibold prose-strong:text-stone-900 prose-img:rounded-xl prose-img:border prose-img:border-stone-200 prose-img:shadow-sm prose-li:text-stone-600 prose-ol:list-decimal prose-ul:list-disc prose-hr:border-stone-100 hover:prose-a:text-stone-500 sm:prose-base">
      <Content />
    </div>
  </section>
</main>

<script>
  const prose = document.querySelector('.prose');
  prose?.querySelectorAll('p').forEach((paragraph) => {
    const text = paragraph.textContent?.trim() || '';
    const isAllCapsHeading =
      text.length > 5 && text === text.toUpperCase() && !text.includes('----');
    const isNumberedHeading = /^\d+\.\s+[A-Z]/.test(text);

    if (isAllCapsHeading || isNumberedHeading) {
      paragraph.className =
        'font-heading font-semibold text-base text-stone-900 mt-10 mb-4 border-b border-stone-200 pb-2 block';
    }
  });
</script>
