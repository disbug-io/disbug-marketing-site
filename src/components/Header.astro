---
import { lifetimeDealStartUrl, loginUrl, signupUrl } from '../config';
---

<nav
  class="sticky top-0 z-50 border-b border-stone-100 bg-white/80 backdrop-blur-md"
  x-data="{ mobileOpen: false }"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6">
    <a
      href="/"
      class="flex items-center gap-2.5 font-heading text-2xl tracking-tight text-stone-900"
    >
      <img
        src="/static/images/brand/disbug-beetle-mark.svg"
        alt=""
        width="32"
        height="32"
        fetchpriority="high"
        class="h-8 w-8 -translate-y-0.5"
      />
      <span class="mt-1">Disbug</span>
    </a>
    <div class="hidden items-center space-x-6 md:flex">
      <a
        href="/#how-it-works"
        class="text-sm font-medium text-stone-500 transition-colors hover:text-stone-900"
      >
        How It Works
      </a>
      <a
        href="/#features"
        class="text-sm font-medium text-stone-500 transition-colors hover:text-stone-900"
      >
        Features
      </a>
      <a
        href="/en/blog/"
        class="text-sm font-medium text-stone-500 transition-colors hover:text-stone-900"
      >
        Blog
      </a>
      <a
        href="/pricing/"
        class="text-sm font-medium text-stone-500 transition-colors hover:text-stone-900"
      >
        Pricing
      </a>

      <a
        href="https://github.com/disbug-io"
        class="text-sm font-medium text-stone-500 transition-colors hover:text-stone-900"
        target="_blank"
        rel="noopener"
      >
        GitHub
      </a>
    </div>
    <div class="hidden items-center space-x-4 md:flex">
      <a href={loginUrl} class="btn btn-ghost btn-sm">
        Sign In
      </a>
      <a href={signupUrl} class="btn btn-accent btn-sm">
        Start Free
      </a>
    </div>
    <button
      class="md:hidden"
      @click="mobileOpen = !mobileOpen"
      aria-label="Toggle navigation menu"
      :aria-expanded="mobileOpen ? 'true' : 'false'"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-5 w-5 text-stone-900"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        width="20"
        height="20"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h8m-8 6h16"
        ></path>
      </svg>
    </button>
  </div>
  <div
    x-show="mobileOpen"
    x-transition
    @click.away="mobileOpen = false"
    class="space-y-3 border-t border-stone-200 bg-white px-6 py-4 md:hidden"
  >
    <a
      href="/#how-it-works"
      class="block text-sm text-stone-500 hover:text-stone-900"
    >
      How It Works
    </a>
    <a
      href="/#features"
      class="block text-sm text-stone-500 hover:text-stone-900"
    >
      Features
    </a>
    <a
      href="/en/blog/"
      class="block text-sm text-stone-500 hover:text-stone-900"
    >
      Blog
    </a>
    <a
      href="/pricing/"
      class="block text-sm text-stone-500 hover:text-stone-900"
    >
      Pricing
    </a>
    <a
      href={lifetimeDealStartUrl('team')}
      class="block text-sm text-stone-500 hover:text-stone-900"
    >
      Lifetime Deal
    </a>
    <a
      href="https://github.com/disbug-io"
      class="block text-sm text-stone-500 hover:text-stone-900"
      target="_blank"
      rel="noopener"
    >
      GitHub
    </a>
    <hr class="border-stone-200" />
    <a
      href={loginUrl}
      class="block text-sm text-stone-500 hover:text-stone-900"
    >
      Sign In
    </a>
    <a href={signupUrl} class="btn btn-accent btn-sm btn-block">
      Start Free
    </a>
  </div>
</nav>
