---
import { signupUrl } from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';

const tiers = [
  {
    name: 'Free',
    slug: 'free',
    tagline: 'For solo builders trying Disbug',
    month: '$0',
    year: '$0',
    period: '/ month',
    annual: '',
    cta: 'Get started',
    href: signupUrl,
    features: [
      '1 team member',
      'Unlimited anonymous reporters',
      '20 most recent sessions',
      'Session replay with console & network logs',
      'Agent-ready briefs via MCP & CLI',
    ],
  },
  {
    name: 'Pro',
    slug: 'pro',
    tagline: 'For small teams shipping with their own coding agents',
    month: '$19',
    year: '$16',
    period: '/ month',
    annual: 'billed $190 / year',
    cta: 'Start with Pro',
    href: signupUrl,
    highlight: true,
    features: [
      'Up to 3 team members',
      'Unlimited projects',
      'Unlimited sessions',
      'Unlimited anonymous reporters',
      'Session replay with console & network logs',
      'Agent-ready briefs via MCP & CLI',
      'All integrations',
    ],
  },
  {
    name: 'Team',
    slug: 'team',
    tagline: 'For teams that need more seats and collaboration',
    month: '$50',
    year: '$42',
    period: '/ month',
    annual: 'billed $500 / year',
    cta: 'Start with Team',
    href: signupUrl,
    features: [
      'Everything in Pro',
      '10 team members included, then $5 / member',
      'Unlimited anonymous reporters',
      'Team roles & advanced collaboration',
      'Priority support',
    ],
  },
  {
    name: 'Enterprise',
    slug: 'enterprise',
    tagline: 'For larger orgs with security & scale needs',
    month: 'Custom',
    year: 'Custom',
    period: '',
    annual: '',
    cta: 'Contact us',
    href: '/contact-us/',
    features: [
      'Everything in Team',
      'Unlimited team members',
      'SSO / SAML',
      'Audit logs & advanced roles',
      'Priority support & SLA',
    ],
  },
];

const faqs = [
  {
    question: 'What counts as a team member (seat)?',
    answer:
      "Anyone who logs into the Disbug dashboard — developers, QA, PMs. People who only submit bugs through the widget are anonymous reporters, and they're always free and unlimited.",
  },
  {
    question: "What happens when I reach my plan's seat limit?",
    answer:
      "Pro includes 3 members. To add more, upgrade to Team (10 included, then $5 per extra member). You're never charged for a seat until you actually invite someone.",
  },
  {
    question: 'Can I change or cancel later?',
    answer:
      "Yes. Manage or cancel anytime from your subscription page — you keep access until the end of the billing period you've already paid for.",
  },
  {
    question: 'How does annual billing work?',
    answer:
      'Pay annually and get two months free versus monthly. You can switch between monthly and annual whenever you like.',
  },
  {
    question: 'Is my payment secure?',
    answer:
      'Payments are processed by Stripe. Disbug never sees or stores your card details.',
  },
];

const tierIcons: Record<string, string> = {
  free: 'hgi-sparkles',
  pro: 'hgi-rocket-02',
  team: 'hgi-user-group',
  enterprise: 'hgi-building-03',
};
---

<BaseLayout
  title="Pricing"
  description="Compare Disbug plans for agent-ready browser bug reports, including the free plan, paid team seats, and enterprise options."
>
  <main id="main-content">
    <section
      class="mx-auto max-w-7xl px-6 py-10"
      x-data="{ interval: 'month' }"
    >
      <div class="mx-auto max-w-3xl text-center">
        <div
          class="mb-6 flex animate-fade-in-up justify-center"
          style="animation-delay: 50ms;"
        >
          <div class="inline-flex items-center gap-2 rounded-full border border-stone-100 bg-stone-50/50 px-4 py-1.5">
            <i class="hgi-stroke hgi-sparkles text-[12px] text-stone-400"></i>
            <span class="ds-label-sm text-stone-400">Flexible Plans</span>
          </div>
        </div>
        <h1
          class="animate-fade-in-up font-heading text-5xl leading-[1.1] tracking-tight text-stone-900 sm:text-5xl lg:text-5xl"
          style="animation-delay: 100ms;"
        >
          Pricing that scales
          <br />
          <span class="italic text-stone-400">with your team.</span>
        </h1>
        <p
          class="mt-4 animate-fade-in-up text-stone-500"
          style="animation-delay: 200ms;"
        >
          Anonymous reporters are always free and unlimited. You only pay for
          teammates who log into the dashboard.
        </p>
      </div>

      <div
        class="mt-8 flex animate-fade-in-up items-center justify-center gap-3"
        style="animation-delay: 300ms;"
      >
        <div class="inline-flex overflow-hidden rounded-3xl border border-stone-200">
          <button
            type="button"
            @click="interval = 'month'"
            :aria-pressed="interval === 'month'"
            class="ds-label px-8 py-2 transition-colors focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-stone-900 focus-visible:outline-none"
            :class="interval === 'month' ? 'bg-stone-900 text-white' : 'bg-white text-stone-900 hover:bg-stone-900/5'"
          >
            Monthly
          </button>
          <button
            type="button"
            @click="interval = 'year'"
            :aria-pressed="interval === 'year'"
            class="ds-label flex items-center justify-center gap-1 px-3 py-2 transition-colors focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-stone-900 focus-visible:outline-none"
            :class="interval === 'year' ? 'bg-stone-900 text-white' : 'bg-white text-stone-900 hover:bg-stone-900/5'"
          >
            Annual
            <span
              class="text-xs font-bold tracking-normal transition-colors"
              :class="interval === 'year' ? 'text-green-300' : 'text-green-700'"
            >
              (16% off)
            </span>
          </button>
        </div>
      </div>

      <div
        class="mt-18 grid animate-fade-in-up gap-6 md:grid-cols-2 lg:grid-cols-4"
        style="animation-delay: 400ms;"
      >
        {tiers.map((tier) => (
          <div
            class:list={[
              'relative flex flex-col rounded-2xl border bg-white p-6',
              tier.highlight
                ? 'border-stone-900 shadow-lg'
                : 'border-stone-200',
            ]}
          >
            {tier.highlight && (
              <span class="badge badge-dark badge-pill absolute -top-3 left-1/2 -translate-x-1/2 gap-1.5 shadow-sm">
                <i class="hgi-stroke hgi-star shrink-0 text-[11px]"></i>
                Most popular
              </span>
            )}

            {tier.slug !== 'free' && tier.slug !== 'enterprise' && (
              <div x-show="interval === 'year'" x-cloak>
                <span class="badge badge-ok badge-pill absolute top-4 right-4 mt-4 gap-1.5">
                  <i class="hgi-stroke hgi-tag-01 shrink-0 text-[10px]"></i>
                  Save 2 months
                </span>
              </div>
            )}

            <div class="mt-3">
              <i
                class:list={[
                  'hgi-stroke text-4xl text-stone-900/70',
                  tierIcons[tier.slug] || 'hgi-package',
                ]}
              ></i>
            </div>
            <h2 class="mt-2 mb-1 font-heading text-2xl text-stone-900">
              {tier.name}
            </h2>
            <p class="mt-1 min-h-[2.5rem] text-sm text-stone-500">
              {tier.tagline}
            </p>

            <div class="mt-4">
              <div class="flex items-baseline gap-1">
                <span
                  class="text-4xl font-bold text-stone-900"
                  x-show="interval === 'month'"
                >
                  {tier.month}
                </span>
                <span
                  class="text-4xl font-bold text-stone-900"
                  x-show="interval === 'year'"
                  x-cloak
                >
                  {tier.year}
                </span>
                {tier.period && (
                  <span class="text-sm text-stone-500">{tier.period}</span>
                )}
              </div>
              {tier.annual && (
                <p
                  class="mt-1 h-4 text-xs text-stone-500"
                  x-show="interval === 'year'"
                  x-cloak
                >
                  {tier.annual}
                </p>
              )}
            </div>

            <a href={tier.href} class="btn btn-accent btn-block mt-5">
              {tier.cta}
            </a>

            <ul class="mt-6 space-y-2.5">
              {tier.features.map((feature) => (
                <li class="flex items-start gap-2 text-sm text-stone-900">
                  <span class="mt-0.5 text-green-700">
                    <i class="hgi-stroke hgi-tick-02"></i>
                  </span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div
        class="mt-8 flex animate-fade-in-up flex-wrap items-center justify-center gap-x-8 gap-y-3 text-xs text-stone-500"
        style="animation-delay: 500ms;"
      >
        <div class="flex items-center gap-2">
          <i class="hgi-stroke hgi-square-lock-02 text-[14px] text-stone-900/40"></i>
          <span>Secure checkout by Stripe</span>
        </div>
        <div class="flex items-center gap-2">
          <i class="hgi-stroke hgi-credit-card text-[14px] text-stone-900/40"></i>
          <span>No credit card to start</span>
        </div>
        <div class="flex items-center gap-2">
          <i class="hgi-stroke hgi-tick-02 text-[14px] text-stone-900/40"></i>
          <span>Cancel anytime</span>
        </div>
      </div>

      <div
        class="mx-auto mt-16 max-w-2xl animate-fade-in-up"
        style="animation-delay: 600ms;"
      >
        <h2 class="text-center font-heading text-2xl text-stone-900">
          Frequently asked questions
        </h2>
        <div class="mt-8 space-y-2.5">
          {faqs.map((faq) => (
            <details class="group overflow-hidden rounded-xl border border-stone-200 bg-white transition-colors hover:border-stone-300">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-4 py-3.5 text-sm font-medium text-stone-900 transition-colors hover:bg-stone-50/50">
                <span>{faq.question}</span>
                <i class="hgi-stroke hgi-arrow-down-01 shrink-0 text-base text-stone-900/40 transition-transform duration-300 group-open:rotate-180"></i>
              </summary>
              <div class="border-t border-stone-100/50 bg-stone-50/30 px-4 pt-1 pb-4">
                <p class="text-[13px] leading-relaxed text-stone-500">
                  {faq.answer}
                </p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
