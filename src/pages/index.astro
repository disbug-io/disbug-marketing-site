---
import LandingPage from '../components/LandingPage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getWidgetSrc, LANDING_PAGE_WIDGET_KEY } from '../lib/widget';
---

<BaseLayout
  title="Faster feedback loop for AI coding agents"
  description="Capture browser bugs with screenshots, console errors, network logs, DOM context, and user events your coding agent can use to ship a real fix."
>
  <main id="main-content">
    <LandingPage />
  </main>
  <script
    slot="page-scripts"
    type="module"
    src={getWidgetSrc()}
    data-project-key={LANDING_PAGE_WIDGET_KEY}
    data-placement="bottom-right"
    data-bar-placement="bottom-center"
    data-success-placement="top-center"
    data-widget-animation="true"
  />
</BaseLayout>
