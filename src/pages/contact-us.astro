---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Disbug"
  description="Contact the Disbug team for product support, demos, or questions about agent-ready browser bug reports."
>
  <main class="relative flex min-h-[calc(100vh-64px)] items-center justify-center overflow-hidden bg-stone-50 px-4 py-10 sm:px-6 lg:px-8">
    <div class="pointer-events-none absolute top-0 left-1/2 h-[400px] w-[800px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-blue-500/5 blur-[120px]"></div>
    <div class="relative z-10 w-full max-w-4xl">
      <div class="relative mb-16 text-center">
        <div class="mb-10 inline-flex animate-fade-in-up items-center rounded-full border border-stone-100 bg-stone-50/50 px-4 py-1.5">
          <p class="ds-label-sm flex items-center gap-2 text-stone-400">
            <i class="hgi-stroke hgi-headset text-xs"></i>
            Contact Support &amp; Sales
          </p>
        </div>

        <h1
          class="mb-8 animate-fade-in-up font-heading text-5xl leading-[1.1] tracking-tight text-stone-900 sm:text-5xl lg:text-5xl"
          style="animation-delay: 100ms;"
        >
          We'd love to hear
          <br />
          <span class="italic text-stone-400">from you.</span>
        </h1>

        <p
          class="mx-auto max-w-2xl animate-fade-in-up leading-relaxed text-stone-500"
          style="animation-delay: 200ms;"
        >
          Whether you have a question, need a product demo, or just want to
          chat, our team is ready to help.
        </p>
      </div>

      <div class="mx-auto grid max-w-3xl grid-cols-1 gap-5 md:grid-cols-2 lg:gap-6">
        <a
          href="mailto:team@disbug.io"
          class="group relative flex animate-fade-in-up flex-col items-center rounded-3xl border border-stone-200 bg-white p-8 text-center shadow-sm transition-all duration-300 hover:-translate-y-1 hover:bg-stone-50 hover:shadow-xl hover:shadow-stone-200/50 sm:p-10"
          style="animation-delay: 100ms;"
        >
          <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-2xl bg-stone-100 text-stone-900 shadow-sm transition-all duration-300 group-hover:scale-110 group-hover:bg-stone-900 group-hover:text-white">
            <i class="hgi-stroke hgi-mail-01 text-xl"></i>
          </div>
          <h2 class="mb-2 font-heading text-xl font-semibold text-stone-900 transition-colors">
            Email Support
          </h2>
          <p class="mx-auto mb-6 max-w-xs flex-1 text-sm leading-relaxed text-stone-500">
            Ask us anything. We'll reply in under 24 hours, most likely much
            faster.
          </p>
          <div class="btn btn-secondary btn-sm bg-stone-50 group-hover:border-stone-400 group-hover:bg-stone-100">
            team@disbug.io
            <i class="hgi-stroke hgi-arrow-up-right-01 text-stone-900/40 transition-colors group-hover:text-stone-900"></i>
          </div>
        </a>

        <a
          href="https://calendly.com/disbug/30min"
          target="_blank"
          rel="noopener"
          class="group relative flex animate-fade-in-up flex-col items-center rounded-3xl border border-stone-200 bg-white p-8 text-center shadow-sm transition-all duration-300 hover:-translate-y-1 hover:bg-stone-50 hover:shadow-xl hover:shadow-stone-200/50 sm:p-10"
          style="animation-delay: 200ms;"
        >
          <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-2xl bg-stone-100 text-stone-900 shadow-sm transition-all duration-300 group-hover:scale-110 group-hover:bg-stone-900 group-hover:text-white">
            <i class="hgi-stroke hgi-customer-support text-xl"></i>
          </div>
          <h2 class="mb-2 font-heading text-xl font-semibold text-stone-900 transition-colors">
            Talk to Sales
          </h2>
          <p class="mx-auto mb-6 max-w-xs flex-1 text-sm leading-relaxed text-stone-500">
            Need a product demo or want to discuss enterprise options? Schedule
            a quick call.
          </p>
          <div class="btn btn-secondary btn-sm bg-stone-50 group-hover:border-stone-400 group-hover:bg-stone-100">
            Book a 30 min chat
            <i class="hgi-stroke hgi-arrow-up-right-01 text-stone-900/40 transition-colors group-hover:text-stone-900"></i>
          </div>
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
