---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import TaxonomyIndex from '../../../../components/TaxonomyIndex.astro';
import { getBlogPosts } from '../../../../lib/content';

const counts = new Map<string, { name: string; count: number }>();
for (const post of await getBlogPosts()) {
  if (!post.data.author_slug) continue;
  const current = counts.get(post.data.author_slug);
  counts.set(post.data.author_slug, {
    name: post.data.author,
    count: (current?.count || 0) + 1,
  });
}
const authors = [...counts.entries()].sort((left, right) =>
  left[1].name.localeCompare(right[1].name),
);
---

<BaseLayout
  title="Authors"
  description="Browse authors from the Disbug blog."
  robots="noindex, follow"
>
  <TaxonomyIndex
    title="Authors"
    items={authors.map(([slug, author]) => ({ slug, ...author }))}
    itemUrlPrefix="/en/blog/authors/"
  />
</BaseLayout>
