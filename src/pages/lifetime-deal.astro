---
import body from '../components/lifetime-deal-body.html?raw';
import script from '../components/lifetime-deal-script.html?raw';
import { APP_URL } from '../config';
import LifetimeDealLayout from '../layouts/LifetimeDealLayout.astro';

const lifetimeDealStartUrl = `${APP_URL}/lifetime-deal/start/`;
const checkoutScript = script.replace(
  '__LIFETIME_DEAL_START_URL__',
  JSON.stringify(lifetimeDealStartUrl),
);
---

<LifetimeDealLayout
  title="Disbug Founding Lifetime Deal"
  description="Pay once for Disbug and capture complete browser-to-agent bug context for life."
>
  <Fragment set:html={body} />
  <Fragment set:html={checkoutScript} />
</LifetimeDealLayout>
